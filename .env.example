# PostgreSQL (used to store analysis snapshots for sharing, AI grounding and comparison)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional AI layer — DOMScope works fully without it.
# AI_PROVIDER: openai | gemini | openrouter | custom
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Only needed for "custom" (any OpenAI-compatible /chat/completions endpoint) or to proxy a provider
AI_BASE_URL=
